{
  "name": "@nscodecom/loso-pos-sdk",
  "version": "0.2.0",
  "description": "Typed client for the Loso POS loyalty API (/api/pos/v1). Grant and spend loyalty on a sale while speaking only in money.",
  "keywords": [
    "loso",
    "pos",
    "loyalty",
    "sdk",
    "point-of-sale",
    "ecr"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nscode-web-org/loso-pos-sdk.git"
  },
  "homepage": "https://github.com/nscode-web-org/loso-pos-sdk#readme",
  "bugs": "https://github.com/nscode-web-org/loso-pos-sdk/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist && node scripts/emit-cjs-types.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package-types": "node scripts/check-package-types.mjs",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  }
}
